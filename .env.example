# --- Core ---
NODE_ENV=development

# Local SQLite database file. Created on first boot along with its parent
# directory, so there is no database server to install or provision. Optional
# for guest curriculum-only mode; required for accounts and progress sync.
DB_FILE=./data/easyeps.db

# Session signing secret. REQUIRED for sign-in: sessions are signed with it, and
# the server refuses to mint one if this is unset or shorter than 32 bytes, since
# a short value can be brute-forced offline to forge any user's session.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# --- Accounts ---
# Auth is self-hosted: email + password, hashed with scrypt. Nothing to register
# with a provider, and no client-side auth configuration.
#
# The FIRST account to register becomes admin. Create it right after deploying,
# before the URL is shared.

# --- SpaceXAI / xAI (AI tutor — preferred) ---
# Get a key: https://console.x.ai  ·  Docs: https://docs.x.ai
XAI_API_KEY=
# Optional overrides (defaults shown):
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.5

# --- Legacy Forge (object storage / optional LLM fallback) ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
# OPENAI_API_KEY=  # treated as forge key fallback only

# Hangul Basics curriculum gate (default off). Set to "true" only after
# Basics UI + grandfather backfill ship. Server + client read via gateStatus.
# BASICS_GATE_ENABLED=false
