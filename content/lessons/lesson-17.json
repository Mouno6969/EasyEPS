  "grammar": [
    {
      "pattern": "V/A + -(으)ㄹ 때",
      "titleBn": "সময়সূচক '-(으)ㄹ 때'",
      "explanationBn": "কোনো কাজ ঘটার সময় বোঝাতে '-(으)ㄹ 때' বসে। বত্ছিম থাকলে '-을 때', না থাকলে '-ㄹ 때'। সময়-বিশেষ্যে '때' সরাসরি: 휴가 때।",
      "explanationEn": "-(으)ㄹ 때 indicates when something happens. -을 때 after consonant, -ㄹ 때 after vowel. Time nouns take 때 directly.",
      "examples": [
        {
          "ko": "시간이 있을 때 여행을 가요.",
          "bn": "সময় থাকলে ভ্রমণে যাই।",
          "en": "I travel when I have time."
        },
        {
          "ko": "제주도에 갈 때 비행기를 타요.",
          "bn": "জেজুতে যাওয়ার সময় বিমানে চড়ি।",
          "en": "I take a plane when going to Jeju."
        },
        {
          "ko": "음식을 만들 때 기분이 좋아요.",
          "bn": "খাবার বানানোর সময় মন ভালো থাকে।",
          "en": "I feel good when cooking."
        }
      ],
      "commonMistakeBn": "'주말', '요일', '오전', '오후'-এর সাথে '때' বসে না।"
    },
    {
      "pattern": "V + -(으)려고 하다",
