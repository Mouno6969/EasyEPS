  "grammar": [
    {
      "pattern": "V + -고 있다 (진행)",
      "titleBn": "চলমান কাজ '-고 있다'",
      "explanationBn": "কাজ চলছে বোঝাতে ক্রিয়ার সাথে '-고 있다' বসে—বাংলার 'করছি/হচ্ছে'। অবস্থার (입고 있어요) থেকে আলাদা: 지금 먹고 있어요 = এখন খাচ্ছি।",
      "explanationEn": "-고 있다 shows an action in progress. 지금 먹고 있어요 = eating now.",
