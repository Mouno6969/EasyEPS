  "grammar": [
    {
      "pattern": "V + -아/어 보다",
      "titleBn": "চেষ্টা '-아/어 보다' (করে দেখা)",
      "explanationBn": "কোনো কাজ পরখ করে করতে '-아/어 보다' বসে—বাংলার 'করে দেখা'। অন্যের কাছে করতে বলতে '-아/어 보세요': 한번 먹어 보세요 (একবার খেয়ে দেখুন)।",
      "explanationEn": "-아/어 보다 means trying something. For recommending, use -아/어 보세요: 한번 먹어 보세요.",
      "examples": [
        {
          "ko": "된장찌개를 만들어 보세요.",
          "bn": "তোয়েনজাং ঝিগে বানিয়ে দেখুন।",
          "en": "Try making doenjang stew."
        },
        {
          "ko": "이 게임이 정말 재미있어요. 한번 해 보세요.",
          "bn": "এই গেমটা সত্যিই মজার। একবার খেলে দেখুন।",
          "en": "This game is really fun. Try it."
        },
        {
          "ko": "그럼 부동산에 가 보세요.",
          "bn": "তাহলে এজেন্সিতে গিয়ে দেখুন।",
          "en": "Then try going to the agency."
        }
      ],
      "commonMistakeBn": "ㅏ/ㅗ স্বরে '-아 보다', অন্য স্বরে '-어 보다', '하다' হলে '-해 보다' বসে।"
    },
    {
      "pattern": "V + -아서/어서 (순차)",
      "titleBn": "ক্রমসূচক '-아서/어서' (করে)",
