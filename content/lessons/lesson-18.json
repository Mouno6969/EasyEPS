  "grammar": [
    {
      "pattern": "V + -는 것",
      "titleBn": "নামকরণ '-는 것' (করা-বিষয়)",
      "explanationBn": "ক্রিয়াকে বিশেষ্যর মতো ব্যবহার করতে '-는 것' বসে—বাংলার 'করা/করাটা'। 음악 듣는 것을 좋아해요 (গান শোনা পছন্দ)। কথ্যে '-는 게', '-는 걸', '-는 거예요' সংক্ষিপ্ত হয়।",
      "explanationEn": "-는 것 makes a verb function like a noun. 음악 듣는 것을 좋아해요. Short forms: -는 게, -는 걸, -는 거예요.",
      "examples": [
        {
          "ko": "칼로 씨는 음악 듣는 것을 좋아해요.",
          "bn": "কার্লো গান শোনা পছন্দ করে।",
          "en": "Carlo likes listening to music."
        },
        {
          "ko": "저는 한국 음식을 만드는 것이 재미있어요.",
          "bn": "কোরীয় খাবার বানানো মজার।",
          "en": "Making Korean food is fun."
        },
        {
          "ko": "영화 보는 거 좋아해요.",
          "bn": "সিনেমা দেখা পছন্দ করি।",
          "en": "I like watching movies."
        }
      ],
      "commonMistakeBn": "타동사에 '-는 것' বসলে কর্মের 을/를 বাদ পড়ে: 옷을 다리는 것 (옷을을 다리는 것 নয়)।"
    },
    {
      "pattern": "V + -(으)ㄹ까요?",
      "titleBn": "প্রস্তাব '-(으)ㄹ까요?' (করবো?)",
      "explanationBn": "কাউকে একসাথে কিছু করতে প্রস্তাব দিতে বা মতামত জিজ্ঞাসা করতে '-(으)ㄹ까요?' বসে—বাংলার 'করবো?'। বত্ছিম→'-을까요?', স্বর/ㄹ→'-ㄹ까요?'।",
